# ── LLM ──────────────────────────────────────────────────────────────────────
# Which LLM provider to use: "ollama" or "openrouter"
LLM_PROVIDER=ollama

# Ollama settings (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# OpenRouter settings (used when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── Embeddings ────────────────────────────────────────────────────────────────
# HuggingFace model name for generating embeddings (runs locally)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Chroma ────────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./storage/chroma_db
CHROMA_COLLECTION_NAME=documents

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./storage/uploads
PROCESSED_DIR=./storage/processed

# ── RAG ───────────────────────────────────────────────────────────────────────
# Number of source chunks to retrieve per query
RAG_TOP_K=5
# Max characters per chunk
CHUNK_SIZE=512
# Character overlap between consecutive chunks
CHUNK_OVERLAP=64

# ── API ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
